model folios {
  id           Int     @id @default(autoincrement()) @db.UnsignedInt
  work_id      Int     @db.UnsignedInt
  position     Int     @db.UnsignedSmallInt
  verse_from   Int     @db.UnsignedSmallInt
  verse_to     Int     @db.UnsignedSmallInt
  has_sections Boolean @default(false)
  band_label   String? @db.VarChar(255)
