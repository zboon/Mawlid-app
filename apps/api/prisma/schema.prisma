  devices    devices? @relation(fields: [device_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_fav_device")
  users      users?   @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_fav_user")
  works      works    @relation(fields: [work_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_fav_work")

  @@unique([device_id, work_id], map: "uq_fav_device")
  @@unique([user_id, work_id], map: "uq_fav_user")
