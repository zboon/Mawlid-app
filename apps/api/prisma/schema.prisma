  languages   languages          @relation(fields: [lang], references: [code], onDelete: NoAction, onUpdate: NoAction, map: "fk_vt_lang")
  verses      verses             @relation(fields: [verse_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_vt_verse")

  @@unique([verse_id, lang, role], map: "uq_versetexts")
  @@index([lang, role], map: "ix_versetexts_lang")
  @@fulltext([body_search], map: "ft_versetexts_search")
}

model verses {
  id                BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  work_id           Int                 @db.UnsignedInt
  position          Int                 @db.UnsignedSmallInt
  verse_kind        verses_verse_kind   @default(verse)
  band_label        String?             @db.VarChar(255)
  note_label        String?             @db.VarChar(255)
  separator_mark    String?             @db.VarChar(16)
  no_rosette        Boolean             @default(false)
  short_page        Boolean             @default(false)
  created_at        DateTime            @default(now()) @db.Timestamp(0)
  updated_at        DateTime            @default(now()) @db.Timestamp(0)
  corrections       corrections[]
  live_sessions     live_sessions[]
  reading_positions reading_positions[]
  verse_marks       verse_marks[]
  verse_texts       verse_texts[]
  works             works               @relation(fields: [work_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_verses_work")

  @@unique([work_id, position], map: "uq_verses_position")
}

model work_translations {
  work_id      Int       @db.UnsignedInt
  lang         String    @db.VarChar(8)
  title        String    @db.VarChar(500)
  note         String?   @db.Text
  title_search String?   @db.VarChar(500)
  languages    languages @relation(fields: [lang], references: [code], onDelete: NoAction, onUpdate: NoAction, map: "fk_worktr_lang")
  works        works     @relation(fields: [work_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_worktr_work")

  @@id([work_id, lang])
  @@index([lang], map: "fk_worktr_lang")
  @@index([title_search(length: 191)], map: "ix_worktr_search")
}

model works {
  id                Int                  @id @default(autoincrement()) @db.UnsignedInt
  collection_id     Int                  @db.UnsignedInt
  slug              String               @db.VarChar(160)
  sort_order        Int                  @default(0) @db.SmallInt
  cartouche         String?              @db.VarChar(255)
  primary_script    works_primary_script @default(arab)
  primary_lang      String               @default("ar") @db.VarChar(8)
  has_folios        Boolean              @default(false)
  status            works_status         @default(draft)
  published_at      DateTime?            @db.Timestamp(0)
  created_at        DateTime             @default(now()) @db.Timestamp(0)
  updated_at        DateTime             @default(now()) @db.Timestamp(0)
  article_works     article_works[]
  corrections       corrections[]
  favorites         favorites[]
  folios            folios[]
  live_sessions     live_sessions[]
  media             media[]
  reading_positions reading_positions[]
  schedule_slots    schedule_slots[]
  sequence_items    sequence_items[]
  text_annotations  text_annotations[]
  verses            verses[]
  work_translations work_translations[]
  collections       collections          @relation(fields: [collection_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_works_coll")
  languages         languages            @relation(fields: [primary_lang], references: [code], onDelete: NoAction, onUpdate: NoAction, map: "fk_works_lang")

  @@unique([collection_id, slug], map: "uq_works_slug")
  @@index([primary_lang], map: "fk_works_lang")
  @@index([collection_id, status, sort_order], map: "ix_works_collection")
}

