  name_en                      String                         @db.VarChar(64)
  direction                    languages_direction            @default(ltr)
  default_script               languages_default_script       @default(latn)
  is_ui_language               Boolean                        @default(false)
  sort_order                   Int                            @default(0) @db.SmallInt
  article_translations         article_translations[]
  collection_translations      collection_translations[]
  module_translations          module_translations[]
  tag_translations             tag_translations[]
  text_annotation_translations text_annotation_translations[]
  users                        users[]
  verse_texts                  verse_texts[]
  work_translations            work_translations[]
  works                        works[]
}

model live_sessions {
  id            String                  @id @db.Char(36)
  join_code     String                  @db.Char(4)
