  expires_at    DateTime                @db.Timestamp(0)
  created_at    DateTime                @default(now()) @db.Timestamp(0)
  updated_at    DateTime                @default(now()) @db.Timestamp(0)
  verses        verses?                 @relation(fields: [verse_id], references: [id], onUpdate: NoAction, map: "fk_live_verse")
  works         works?                  @relation(fields: [work_id], references: [id], onUpdate: NoAction, map: "fk_live_work")

  @@unique([join_code, active_flag], map: "uq_live_code_active")
  @@index([verse_id], map: "fk_live_verse")
  @@index([work_id], map: "fk_live_work")
  @@index([expires_at], map: "ix_live_expiry")
