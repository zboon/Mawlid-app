generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model article_links {
  from_article_id                                  Int      @db.UnsignedInt
  to_article_id                                    Int      @db.UnsignedInt
  relation                                         String   @default("related") @db.VarChar(64)
  articles_article_links_from_article_idToarticles articles @relation("article_links_from_article_idToarticles", fields: [from_article_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_allink_from")
  articles_article_links_to_article_idToarticles   articles @relation("article_links_to_article_idToarticles", fields: [to_article_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_allink_to")

  @@id([from_article_id, to_article_id, relation])
  @@index([to_article_id], map: "fk_allink_to")
}

model article_translations {
  article_id  Int       @db.UnsignedInt
  lang        String    @db.VarChar(8)
  title       String    @db.VarChar(500)
  summary     String?   @db.Text
  body_md     String?   @db.MediumText
  body_html   String?   @db.MediumText
  body_search String?   @db.MediumText
  articles    articles  @relation(fields: [article_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_arttr_art")
  languages   languages @relation(fields: [lang], references: [code], onDelete: NoAction, onUpdate: NoAction, map: "fk_arttr_lang")

  @@id([article_id, lang])
  @@index([lang], map: "fk_arttr_lang")
  @@fulltext([title, body_search], map: "ft_articles_search")
}

model article_works {
  article_id Int      @db.UnsignedInt
  work_id    Int      @db.UnsignedInt
  relation   String   @default("about") @db.VarChar(64)
  articles   articles @relation(fields: [article_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_aw_article")
  works      works    @relation(fields: [work_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_aw_work")

  @@id([article_id, work_id, relation])
  @@index([work_id], map: "fk_aw_work")
}

model articles {
  id                                                    Int                    @id @default(autoincrement()) @db.UnsignedInt
  module_id                                             Int                    @db.UnsignedInt
  parent_id                                             Int?                   @db.UnsignedInt
  slug                                                  String                 @db.VarChar(160)
  sort_order                                            Int                    @default(0) @db.SmallInt
  status                                                articles_status        @default(draft)
  lifespan_from                                         String?                @db.VarChar(32)
  lifespan_to                                           String?                @db.VarChar(32)
  cover_url                                             String?                @db.VarChar(1024)
  published_at                                          DateTime?              @db.Timestamp(0)
  created_at                                            DateTime               @default(now()) @db.Timestamp(0)
  updated_at                                            DateTime               @default(now()) @db.Timestamp(0)
  article_links_article_links_from_article_idToarticles article_links[]        @relation("article_links_from_article_idToarticles")
  article_links_article_links_to_article_idToarticles   article_links[]        @relation("article_links_to_article_idToarticles")
  article_translations                                  article_translations[]
  article_works                                         article_works[]
  modules                                               modules                @relation(fields: [module_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_art_module")
  articles                                              articles?              @relation("articlesToarticles", fields: [parent_id], references: [id], onUpdate: NoAction, map: "fk_art_parent")
  other_articles                                        articles[]             @relation("articlesToarticles")

  @@unique([module_id, slug], map: "uq_articles_slug")
  @@index([module_id, status, sort_order], map: "ix_articles_module")
  @@index([parent_id, sort_order], map: "ix_articles_tree")
}

model audit_log {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  user_id     Int?     @db.UnsignedInt
  action      String   @db.VarChar(64)
  entity_type String?  @db.VarChar(64)
  entity_id   BigInt?  @db.UnsignedBigInt
  meta        Json?
  created_at  DateTime @default(now()) @db.Timestamp(0)
  users       users?   @relation(fields: [user_id], references: [id], onUpdate: NoAction, map: "fk_audit_user")

  @@index([created_at], map: "ix_audit_time")
  @@index([user_id, created_at], map: "ix_audit_user")
}

model auth_sessions {
  id         String   @id @db.Char(36)
  user_id    Int      @db.UnsignedInt
  token_hash String   @unique(map: "uq_authsess_token") @db.Char(64)
  expires_at DateTime @db.Timestamp(0)
  user_agent String?  @db.VarChar(512)
  ip_hash    String?  @db.Char(64)
  created_at DateTime @default(now()) @db.Timestamp(0)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_authsess_user")

  @@index([user_id, expires_at], map: "ix_authsess_user")
}

model collection_translations {
  collection_id Int         @db.UnsignedInt
  lang          String      @db.VarChar(8)
  title         String      @db.VarChar(255)
  subtitle      String?     @db.VarChar(255)
  description   String?     @db.Text
  collections   collections @relation(fields: [collection_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_colltr_coll")
  languages     languages   @relation(fields: [lang], references: [code], onDelete: NoAction, onUpdate: NoAction, map: "fk_colltr_lang")

  @@id([collection_id, lang])
  @@index([lang], map: "fk_colltr_lang")
}

model collections {
  id                      Int                       @id @default(autoincrement()) @db.UnsignedInt
  module_id               Int                       @db.UnsignedInt
  parent_id               Int?                      @db.UnsignedInt
  slug                    String                    @db.VarChar(96)
  sort_order              Int                       @default(0) @db.SmallInt
  is_published            Boolean                   @default(false)
  content_version         BigInt                    @default(1) @db.UnsignedBigInt
  created_at              DateTime                  @default(now()) @db.Timestamp(0)
  updated_at              DateTime                  @default(now()) @db.Timestamp(0)
  collection_translations collection_translations[]
  modules                 modules                   @relation(fields: [module_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_coll_module")
  collections             collections?              @relation("collectionsTocollections", fields: [parent_id], references: [id], onUpdate: NoAction, map: "fk_coll_parent")
  other_collections       collections[]             @relation("collectionsTocollections")
  schedules               schedules[]
  sequences               sequences[]
  works                   works[]

  @@unique([module_id, slug], map: "uq_collections_slug")
  @@index([module_id, is_published, sort_order], map: "ix_collections_module")
  @@index([parent_id, sort_order], map: "ix_collections_parent")
}

model content_revisions {
  id          BigInt                        @id @default(autoincrement()) @db.UnsignedBigInt
  entity_type content_revisions_entity_type
  entity_id   BigInt                        @db.UnsignedBigInt
  revision    Int                           @db.UnsignedInt
  payload     Json
  author_id   Int?                          @db.UnsignedInt
  note        String?                       @db.VarChar(500)
  created_at  DateTime                      @default(now()) @db.Timestamp(0)
  users       users?                        @relation(fields: [author_id], references: [id], onUpdate: NoAction, map: "fk_rev_author")

  @@unique([entity_type, entity_id, revision], map: "uq_rev")
  @@index([author_id, created_at], map: "ix_rev_author")
}

model corrections {
  id            BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  work_id       Int?               @db.UnsignedInt
  verse_id      BigInt?            @db.UnsignedBigInt
  reporter_name String?            @db.VarChar(160)
  reporter_mail String?            @db.VarChar(255)
  body          String             @db.Text
  status        corrections_status @default(new)
  handled_by    Int?               @db.UnsignedInt
  handled_at    DateTime?          @db.Timestamp(0)
  created_at    DateTime           @default(now()) @db.Timestamp(0)
  users         users?             @relation(fields: [handled_by], references: [id], onUpdate: NoAction, map: "fk_corr_handler")
  verses        verses?            @relation(fields: [verse_id], references: [id], onUpdate: NoAction, map: "fk_corr_verse")
  works         works?             @relation(fields: [work_id], references: [id], onUpdate: NoAction, map: "fk_corr_work")

  @@index([handled_by], map: "fk_corr_handler")
  @@index([verse_id], map: "fk_corr_verse")
  @@index([work_id], map: "fk_corr_work")
  @@index([status, created_at], map: "ix_corr_status")
}

model devices {
  id                Int                 @id @default(autoincrement()) @db.UnsignedInt
  public_id         String              @unique(map: "uq_devices_public") @db.Char(36)
  user_id           Int?                @db.UnsignedInt
  label             String?             @db.VarChar(160)
  last_seen_at      DateTime?           @db.Timestamp(0)
  created_at        DateTime            @default(now()) @db.Timestamp(0)
  users             users?              @relation(fields: [user_id], references: [id], onUpdate: NoAction, map: "fk_devices_user")
  favorites         favorites[]
  reading_positions reading_positions[]
  verse_marks       verse_marks[]

  @@index([user_id], map: "ix_devices_user")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
