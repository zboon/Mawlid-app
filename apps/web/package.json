{
  "name": "@mawalid/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --ext .ts,.vue",
    "check:tokens": "node ../../tools/check-tokens.mjs src",
    "verify": "npm run typecheck && npm run lint && npm run check:tokens && npm run test",
    "test": "vitest run"
  },
  "dependencies": {
    "@tanstack/vue-query": "^5.102.8",
    "pinia": "^2.2.6",
    "vue": "^3.5.13",
    "vue-i18n": "^11.1.2",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^9.32.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vite": "^6.0.3",
    "vitest": "^5.0.0",
    "vue-tsc": "^2.1.10"
  }
}
