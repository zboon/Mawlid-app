# Kopieren nach .env und anpassen. .env gehört NICHT ins Repository.

# --- Datenbank ---------------------------------------------------------------
MYSQL_ROOT_PASSWORD=mawalid-dev
MYSQL_DATABASE=mawalid
MYSQL_USER=mawalid
MYSQL_PASSWORD=mawalid-dev
MYSQL_PORT=3306

# Der Parameter charset=utf8mb4 ist NICHT optional. Ohne ihn verhandelt der
# Treiber unter Umständen latin1 und arabischer Text kommt verstümmelt an —
# sichtbar wird das erst an einem einzelnen Fragezeichen mitten in einer Sure.
DATABASE_URL=mysql://mawalid:mawalid-dev@localhost:3306/mawalid?charset=utf8mb4

# --- API ---------------------------------------------------------------------
API_PORT=3000
# Zufällig erzeugen:  openssl rand -base64 48
SESSION_SECRET=

# --- Oberfläche --------------------------------------------------------------
WEB_PORT=5173
VITE_API_URL=http://localhost:3000

# --- Medien ------------------------------------------------------------------
# Basis-URL der Rezitationsdateien. Heute: https://zboon.github.io/mawlid-audio/
AUDIO_BASE_URL=https://zboon.github.io/mawlid-audio/
